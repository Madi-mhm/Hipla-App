{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "crons": [
    {
      "path": "/api/qonto?soir=ete",
      "schedule": "30 21 * * *"
    },
    {
      "path": "/api/qonto?soir=hiver",
      "schedule": "30 22 * * *"
    },
    {
      "path": "/api/cron/sauvegarde",
      "schedule": "0 3 * * 0,3"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ]
}
