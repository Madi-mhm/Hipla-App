# Copier ce fichier en .env.local et remplir les valeurs.
# .env.local est ignoré par git : les secrets n'entrent jamais dans le dépôt.
# Ce modèle ne contient AUCUNE valeur réelle.

# --- Public : exposé au navigateur, protégé par les politiques RLS ---
NEXT_PUBLIC_SUPABASE_URL=https://<projet>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- SECRET : jamais dans le dépôt, jamais côté navigateur ---
SUPABASE_SERVICE_ROLE_KEY=

# --- Cloudflare R2 : archive des sauvegardes ---
R2_ACCOUNT_ID=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# --- Cron Vercel ---
# Chaîne aléatoire longue (32 caractères ou plus). OBLIGATOIRE : sans elle,
# les routes de cron refusent tout appel.
CRON_SECRET=

# --- Extraction des factures (console.anthropic.com) ---
ANTHROPIC_API_KEY=

# --- Qonto : lecture des opérations bancaires (clé en lecture seule) ---
QONTO_LOGIN=
QONTO_SECRET_KEY=
